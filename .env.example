# Halcyon Flight Ops: copy to .env and fill in. Never commit .env.

# offline = canned synthetic data, no AWS calls. live = real Bedrock + AgentCore.
DEMO_MODE=offline

# Local web server (keep on loopback; the app has no authentication)
HOST=127.0.0.1
PORT=8080

# AWS (credentials come from your normal AWS credential chain / AWS_PROFILE)
AWS_REGION=us-east-1

# AgentCore Runtime ARN printed by scripts/deploy_mcp.sh
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/halcyonFlightOps-EXAMPLE

# Execution role the AgentCore Runtime assumes (used by scripts/deploy_mcp.sh)
AGENTCORE_ROLE_ARN=arn:aws:iam::123456789012:role/halcyon-flight-ops-agentcore-runtime

# Bedrock cross-region inference profile used by the chat agent
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5

# ECS cluster the dashboard and tools inspect
ECS_CLUSTER=halcyon-flight-ops
ECR_REPO=halcyon-flight-ops-mcp
